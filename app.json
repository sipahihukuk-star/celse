{
  "expo": {
    "name": "Celse",
    "slug": "celse",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "celse",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1c0a0f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.themiscode.celse",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleLocalizations": [
          "tr",
          "en",
          "es",
          "fr",
          "de"
        ]
      }
    },
    "android": {
      "package": "com.themiscode.celse",
      "adaptiveIcon": {
        "backgroundColor": "#5a0f1c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Celse",
      "backgroundColor": "#1c0a0f",
      "themeColor": "#161c22"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#1c0a0f"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0f43df6e-12d0-4f8c-b779-77f503add543"
      }
    },
    "owner": "themiscodecelse",
    "runtimeVersion": "1.0.0-odeme",
    "updates": {
      "url": "https://u.expo.dev/0f43df6e-12d0-4f8c-b779-77f503add543",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
